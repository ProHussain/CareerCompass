<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.fragments.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">

        <TextView
            android:id="@+id/tvProfileMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/urbanist_bold"
            android:lineSpacingExtra="2dp"
            android:text="@string/message_profile"
            android:textColor="@color/dark"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/tvBasics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="@string/basics"
            android:textColor="@color/dark"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_et_auth"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEducation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="@string/education"
            android:textColor="@color/dark"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_et_auth"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvDegree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvInstitute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvCGPA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvPassingYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

            <TextView
                android:id="@+id/tvFavoriteSubjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/hint_name"
                android:textColor="@color/darkGrey" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvAbout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/urbanist_semi_bold"
            android:text="@string/about"
            android:textColor="@color/dark"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvBio"
            android:padding="18dp"
            android:lines="3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_et_auth"
            android:text="@string/hint_name"
            android:textColor="@color/darkGrey" />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="32dp"
            android:text="@string/logout"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:background="@drawable/bg_btn_auth"/>

    </LinearLayout>

</ScrollView>